<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Email Address</title>
  </head>
  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f0f4f8;
      font-family:
        -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, Roboto,
        Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    "
  >
    <table
      role="presentation"
      border="0"
      cellpadding="0"
      cellspacing="0"
      width="100%"
      style="background-color: #f0f4f8; padding: 40px 16px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            border="0"
            cellpadding="0"
            cellspacing="0"
            width="100%"
            style="
              max-width: 480px;
              background-color: #ffffff;
              border-radius: 20px;
              overflow: hidden;
              box-shadow: 0 12px 30px rgba(14, 165, 233, 0.08);
              border: 1px solid #e0f2fe;
            "
          >
            <!-- Header Accent Banner (Soothing Sky-to-Teal Gradient) -->
            <tr>
              <td
                style="
                  background: linear-gradient(135deg, #0284c7 0%, #0d9488 100%);
                  padding: 36px 24px;
                  text-align: center;
                "
              >
                <div
                  style="
                    background-color: rgba(255, 255, 255, 0.18);
                    width: 64px;
                    height: 64px;
                    border-radius: 50%;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    margin-bottom: 14px;
                    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
                  "
                >
                  <span style="font-size: 30px; line-height: 1">✨</span>
                </div>
                <h1
                  style="
                    color: #ffffff;
                    margin: 0;
                    font-size: 23px;
                    font-weight: 700;
                    letter-spacing: -0.02em;
                  "
                >
                  Verify Your Email
                </h1>
                <p
                  style="
                    color: #e0f2fe;
                    margin: 6px 0 0 0;
                    font-size: 13px;
                    font-weight: 400;
                  "
                >
                  One final step to get started
                </p>
              </td>
            </tr>

            <!-- Body Content -->
            <tr>
              <td style="padding: 32px 28px; text-align: center">
                <p
                  style="
                    margin: 0 0 10px 0;
                    font-size: 17px;
                    color: #0f172a;
                    font-weight: 700;
                  "
                >
                  Welcome, <%= typeof name !== 'undefined' ? name : 'Friend' %>
                  👋
                </p>
                <p
                  style="
                    margin: 0 0 20px 0;
                    font-size: 14px;
                    color: #475569;
                    line-height: 1.6;
                  "
                >
                  Thank you for signing up! Please verify your email address
                  <strong style="color: #0284c7"
                    ><%= typeof email !== 'undefined' ? email : '' %></strong
                  >
                  to complete your account setup.
                </p>

                <!-- Verification OTP Card -->
                <div
                  style="
                    background: linear-gradient(
                      180deg,
                      #f0f9ff 0%,
                      #e0f2fe 100%
                    );
                    border: 1px solid #bae6fd;
                    border-radius: 16px;
                    padding: 24px 20px;
                    margin-bottom: 24px;
                    text-align: center;
                  "
                >
                  <span
                    style="
                      display: block;
                      font-size: 11px;
                      font-weight: 700;
                      text-transform: uppercase;
                      letter-spacing: 0.12em;
                      color: #0369a1;
                      margin-bottom: 10px;
                    "
                  >
                    Your Verification Code
                  </span>
                  <span
                    style="
                      font-family: &quot;Courier New&quot;, Courier, monospace;
                      font-size: 38px;
                      font-weight: 800;
                      letter-spacing: 8px;
                      color: #0284c7;
                      display: inline-block;
                      background-color: #ffffff;
                      padding: 8px 20px;
                      border-radius: 10px;
                      box-shadow: 0 2px 8px rgba(2, 132, 199, 0.12);
                    "
                  >
                    <%= otp %>
                  </span>
                </div>

                <!-- Timer Badge -->
                <div
                  style="
                    display: inline-block;
                    background-color: #fff7ed;
                    border: 1px solid #ffedd5;
                    border-radius: 20px;
                    padding: 6px 16px;
                    margin-bottom: 24px;
                  "
                >
                  <p
                    style="
                      margin: 0;
                      font-size: 12px;
                      color: #c2410c;
                      font-weight: 600;
                    "
                  >
                    ⏱️ Expires in <%= typeof expirationMinutes !== 'undefined' ?
                    Math.floor(expirationMinutes / 60) : 5 %> minutes
                  </p>
                </div>

                <p
                  style="
                    margin: 0;
                    font-size: 12px;
                    color: #94a3b8;
                    line-height: 1.5;
                  "
                >
                  If you didn't create an account with us, you can safely ignore
                  this message.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background-color: #f8fafc;
                  border-top: 1px solid #f1f5f9;
                  padding: 18px 24px;
                  text-align: center;
                "
              >
                <p style="margin: 0; font-size: 11px; color: #94a3b8">
                  © <%= new Date().getFullYear() %> Courier & Logistics Platform
                  . All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
