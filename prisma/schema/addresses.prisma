model Address {
  id          String   @id @default(uuid())
  userId      String
  label       String
  contactName String
  phone       String
  addressLine String
  city        String
  district    String
  postalCode  String
  latitude    Decimal?
  longitude   Decimal?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  senderShipments   Shipment[] @relation("SenderAddress")
  receiverShipments Shipment[] @relation("ReceiverAddress")

  @@index([userId])
  @@index([district])
  @@index([city])
  @@map("addresses")
}
