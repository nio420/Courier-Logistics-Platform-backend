model Hub {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  address   String
  city      String
  district  String
  latitude  Decimal?
  longitude Decimal?
  status    HubStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Shipments originating from this hub
  originShipments Shipment[] @relation("OriginHub")

  // Shipments going to this hub
  destinationShipments Shipment[] @relation("DestinationHub")

  // Shipments currently located at this hub
  currentShipments Shipment[] @relation("CurrentHub")

  // Tracking events at this hub
  trackingEvents ShipmentTracking[]

  @@index([city])
  @@index([district])
  @@index([status])
  @@map("hubs")
}
